* text=auto

# Trust documents are hashed as raw bytes and must be checkout-stable.
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
LICENSE -text diff whitespace=cr-at-eol
NOTICE -text diff whitespace=cr-at-eol
*.pem text eol=lf
*.sig text eol=lf

# Model and runtime packages are binary and must never be normalized.
*.gguf -text
*.safetensors -text
*.zip -text
*.gz -text
*.zst -text
